# Symlink/copy for local tools that expect .env at repo root.
# Preferred file: deploy/private/energy.env
#
#   cp deploy/private/energy.env.example deploy/private/energy.env
#   ln -sf deploy/private/energy.env .env
#
# See deploy/private/energy.env.example for all keys.
DOCKFIRE_ENV_FILE=deploy/private/energy.env
