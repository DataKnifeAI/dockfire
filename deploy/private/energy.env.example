# Energy credentials for DockFire live solar / battery stats.
# Copy to energy.env (gitignored) for local test:
#   cp deploy/private/energy.env.example deploy/private/energy.env
#
# Apply to the cluster:
#   ./scripts/apply-energy-secret.sh
#
# Leave blank to keep “online only” probes (no secrets required).

# --- Tesla Powerwall (local gateway) ---
# Host of the Powerwall / Tesla Energy Gateway
TESLA_HOST=https://tesla.dataknife.net
# Customer login used on the local gateway UI (not your Tesla.com password unless they match)
TESLA_EMAIL=
TESLA_PASSWORD=
# Optional: paste AuthCookie from a browser session instead of email/password
TESLA_AUTH_COOKIE=

# --- Enphase Envoy (local) ---
ENPHASE_HOST=https://envoy.dataknife.net
# Owner JWT from Enlighten (valid ~1 year for owners):
#   https://enlighten.enphaseenergy.com/entrez-auth-token?serial_num=<ENVOY_SERIAL>
ENPHASE_TOKEN=
# Optional: serial if you automate token refresh later
ENPHASE_SERIAL=

# --- SolarEdge (cloud monitoring API) ---
# From https://monitoring.solaredge.com/ → Admin → Site Access → API Access
SOLAREDGE_API_KEY=
SOLAREDGE_SITE_ID=
# Optional local gateway if/when it appears on LAN
SOLAREDGE_HOST=
